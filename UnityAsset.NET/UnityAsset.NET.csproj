<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <Authors>AXiX</Authors>
        <Description>A work-in-progress .NET library for parsing/serializing/patching Unity Engine asset files.</Description>
        <Version>0.5.0</Version>
        <AssemblyVersion>0.5.0</AssemblyVersion>
        <FileVersion>0.5.0</FileVersion>
        <Title>UnityAsset.NET</Title>
        <Copyright>AXiX</Copyright>
        <IsPackable>true</IsPackable>
        <PackageProjectUrl>https://github.com/AXiX-official/UnityAsset.NET</PackageProjectUrl>
        <RepositoryUrl>https://github.com/AXiX-official/UnityAsset.NET</RepositoryUrl>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <Description>A work-in-progress .NET library for parsing/serializing/patching Unity Engine asset files.</Description>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <PackageTags>Unity</PackageTags>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <NoWarn>CS8981</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Condition="'$(UnityAssetNodeData)' != 'true'" Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
      <PackageReference Condition="'$(UnityAssetNodeData)' != 'true'" Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
      <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
      <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
      <PackageReference Include="AssetRipper.TextureDecoder" Version="2.4.0" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\UnityAsset.NET.BundleFiles\UnityAsset.NET.BundleFiles.csproj" />
      <ProjectReference Include="..\UnityAsset.NET.Core\UnityAsset.NET.Core.csproj" />
      <ProjectReference Include="..\UnityAsset.NET.TypeTreeHelper\UnityAsset.NET.TypeTreeHelper.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="UnityAsset.NET.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The same generator emits the JIT backend's RefSum types, so it always has to run; only the NodeData
             adapter half is conditional, decided inside the generator from the UnityAssetNodeData property. -->
        <ProjectReference Include="..\UnityAsset.NET.SourceGenerator\UnityAsset.NET.SourceGenerator.csproj"
                          GlobalPropertiesToRemove="TargetFramework;PublishAot;RuntimeIdentifier;SelfContained"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <CompilerVisibleProperty Include="UnityAssetNodeData" />
    </ItemGroup>

</Project>
